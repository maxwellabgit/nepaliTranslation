{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight-internal",
      "autoIncrement": true,
      "ios": {
        "image": "sdk-57",
        "resourceClass": "m-medium"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_ADS_ENV": "test",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "testflight-internal"
      }
    },
    "testflight-ssv": {
      "distribution": "store",
      "channel": "testflight-internal",
      "autoIncrement": true,
      "ios": {
        "image": "sdk-57",
        "resourceClass": "m-medium"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_ADS_ENV": "test-ssv",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "testflight-ssv-internal"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "sdk-57",
        "resourceClass": "m-medium"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production"
      }
    }
  },
  "submit": {
    "testflight-ssv": {
      "ios": {
        "ascAppId": "6792574384",
        "appleTeamId": "BSQ5SYHX54",
        "bundleIdentifier": "com.neptranslate.app"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6792574384",
        "appleTeamId": "BSQ5SYHX54",
        "bundleIdentifier": "com.neptranslate.app"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6792574384",
        "appleTeamId": "BSQ5SYHX54",
        "bundleIdentifier": "com.neptranslate.app"
      },
      "android": {
        "applicationId": "com.neptranslate.app",
        "track": "internal"
      }
    }
  }
}
