EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional legal / support HTTPS URLs (leave empty until live hosting).
# Settings shows honest "not live yet" copy when unset.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_DELETION_INFO_URL=
EXPO_PUBLIC_APP_ADS_TXT_URL=

# Optional internal TestFlight SSV profile. Keep the ordinary "testflight"
# profile on Google's demo IDs; those demo IDs cannot reach your SSV callback.
# These AdMob IDs are public identifiers, never service keys. Only enroll
# physical devices you control as test devices in the AdMob console.
# Set these variables in EAS for the "testflight-ssv" build profile.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
