{
  "name": "neptranslate",
  "version": "1.6.2",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@huggingface/tokenizers": "^0.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^21.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:lexicon": "node ./scripts/export_meaning_lexicon.mjs",
    "verify:translate": "node ./scripts/export_meaning_lexicon.mjs && node scripts/verify_translate_fix.mjs && node scripts/verify_romanize.mjs",
    "fetch:models": "node ./scripts/eas_fetch_it2_models.mjs",
    "fetch:whisper": "node ./scripts/fetch_whisper_nepali.mjs",
    "eas-build-pre-install": "node ./scripts/export_meaning_lexicon.mjs && node ./scripts/eas_fetch_it2_models.mjs",
    "eas-build-post-install": "node ./scripts/export_meaning_lexicon.mjs && node ./scripts/eas_fetch_it2_models.mjs",
    "eas:configure": "eas build:configure",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "private": true
}
