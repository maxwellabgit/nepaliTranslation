{
  "name": "neptranslate",
  "version": "1.6.2",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@huggingface/tokenizers": "^0.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "neptranslate-ocr": "file:./modules/neptranslate-ocr",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:lexicon": "node ./scripts/export_meaning_lexicon.mjs",
    "lint": "eslint App.tsx src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration-test",
    "test:integration": "jest --runInBand --testPathPattern=integration-test",
    "test:coverage": "jest --coverage --runInBand --testPathIgnorePatterns=integration-test",
    "test:coverage:beta": "node ./scripts/check_beta_coverage.mjs",
    "verify:translate": "node ./scripts/export_meaning_lexicon.mjs && node scripts/verify_translate_fix.mjs && node scripts/verify_romanize.mjs",
    "verify:beta": "npm run export:lexicon && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run verify:translate && npx expo-doctor",
    "fetch:models": "node ./scripts/eas_fetch_it2_models.mjs",
    "eas-build-pre-install": "node ./scripts/export_meaning_lexicon.mjs && node ./scripts/eas_fetch_it2_models.mjs",
    "eas-build-post-install": "node ./scripts/export_meaning_lexicon.mjs && node ./scripts/eas_fetch_it2_models.mjs",
    "eas:configure": "eas build:configure",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*-test.[jt]s?(x)",
      "**/__tests__/**/*.integration-test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase|react-native-google-mobile-ads)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/mt/generated/**",
      "!**/__tests__/**",
      "!**/*.styles.ts"
    ]
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
