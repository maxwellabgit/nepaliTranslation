{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NepTranslate Testing Ground",
  "version": "0.1.0",
  "identifier": "com.neptranslate.testingground",
  "build": {
    "beforeDevCommand": "npm run prepare:hosted && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run prepare:hosted && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NepTranslate Testing Ground (engineering only)",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
